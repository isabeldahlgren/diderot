# Copy this file to .env and fill in the values.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://openauthor:openauthor@localhost:5432/openauthor

# Directory where uploaded PDFs are stored (relative to backend/)
UPLOAD_DIR=./uploads

# Secret key for signing JWT tokens — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# URL of the frontend (used in CORS and email links)
FRONTEND_URL=http://localhost:3000

# Public URL of the backend (used in ORCID redirect URI and email links)
APP_URL=http://localhost:8000

# ORCID OAuth credentials
# Register a free app at https://sandbox.orcid.org (sandbox, instant)
# or https://orcid.org/developer-tools (production, needs approval).
ORCID_ENV=sandbox
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:8000/api/v1/auth/orcid/callback

# Resend — used for magic-link email auth
# Get a free API key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
